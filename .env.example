# Postgres (no Coolify: "Postgres URL (internal)" do serviço Postgres)
DATABASE_URL="postgres://usuario:senha@host-interno:5432/clinicat"
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"
# Diretório do volume de uploads
UPLOAD_DIR="/app/public/uploads"
# Seed do admin (usado por prisma/seed.js)
ADMIN_EMAIL="admin@clinicat.com"
ADMIN_PASSWORD="defina-uma-senha-forte"
ADMIN_NAME="Administração Clinicat"
