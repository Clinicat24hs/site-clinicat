# Postgres (no Coolify: "Postgres URL (internal)" do serviço Postgres)
DATABASE_URL="postgres://usuario:senha@host-interno:5432/clinicat"
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"
# Diretório do volume de uploads
UPLOAD_DIR="/app/public/uploads"
# Seed do admin (usado por prisma/seed.js)
ADMIN_EMAIL="admin@clinicat.com"
ADMIN_PASSWORD="defina-uma-senha-forte"
ADMIN_NAME="Administração Clinicat"

# --- Mídia paga (opcionais; sem elas nenhuma tag é carregada) ---
# Meta Pixel: Gerenciador de Eventos → Fontes de dados → ID do pixel
NEXT_PUBLIC_META_PIXEL_ID=""
# Google: AW-XXXXXXXXX (Google Ads) ou G-XXXXXXX (GA4)
NEXT_PUBLIC_GOOGLE_TAG_ID=""
# Rótulos de conversão do Google Ads, um por canal.
# Formato "AW-XXXXXXXXX/AbC-D_efGh". Google Ads → Metas → Conversões →
# a ação → "Instalar a tag manualmente" → copiar o send_to.
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=""
NEXT_PUBLIC_GADS_LABEL_PHONE=""
NEXT_PUBLIC_GADS_LABEL_FORM=""
